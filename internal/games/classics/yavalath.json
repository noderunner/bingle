{
  "id": "yavalath",
  "name": "Yavalath",
  "description": "Make four in a row to win — but make three in a row first and you lose. A misère-flavoured race on a hexagonal board.",
  "version": "0.3.0",
  "designers": ["Cameron Browne"],
  "publisher": "nestorgames",
  "rules": [
    "White and Black alternate placing one piece on any empty cell of the hexagonal board; White moves first.",
    "A player who makes a line of four or more of their own pieces wins.",
    "A player who makes a line of exactly three of their own pieces — without also making four — loses.",
    "If the board fills up with neither, the game is a draw.",
    "Optional (chosen when the game is made): with the pie rule, the second player may swap sides on their first turn instead of replying; the players change seats and the opening move changes hands with them."
  ],
  "guide": { "tabs": [ { "id": "rules", "title": "Rules", "file": "rules.md" } ] },
  "preview": [
    { "position": "e5", "piece": "piece", "color": "white" },
    { "position": "f5", "piece": "piece", "color": "white" },
    { "position": "d6", "piece": "piece", "color": "white" },
    { "position": "g4", "piece": "piece", "color": "white" },
    { "position": "c5", "piece": "piece", "color": "white" },
    { "position": "e4", "piece": "piece", "color": "black" },
    { "position": "d5", "piece": "piece", "color": "black" },
    { "position": "f6", "piece": "piece", "color": "black" },
    { "position": "d7", "piece": "piece", "color": "black" },
    { "position": "g3", "piece": "piece", "color": "black" }
  ],
  "board": {
    "generator": { "type": "hexhex", "size": 5 }
  },
  "seats": [
    { "seat": 1, "color": "white", "label": "White" },
    { "seat": 2, "color": "black", "label": "Black" }
  ],
  "pieces": {
    "piece": { "label": "Piece", "shape": "disc" }
  },
  "pie_rule": "optional",
  "turn_order": { "type": "round-robin", "seats": [1, 2] },
  "actions": [
    { "id": "place", "type": "place", "label": "Place a piece", "pieces": ["piece"], "source": "supply" }
  ],
  "win_condition": {
    "type": "rules",
    "rules": [
      { "id": "four", "type": "line", "length": 4, "reason": "four-in-a-row" },
      { "id": "three", "type": "line", "length": 3, "result": "lose", "reason": "three-in-a-row" },
      { "id": "full", "type": "end", "when": ["board-full"], "decide": { "type": "draw" }, "reason": "draw" }
    ]
  }
}
