{
  "id": "gomoku",
  "name": "Gomoku (15×15)",
  "description": "Five in a row on a Go board. Black moves first.",
  "version": "0.1.0",
  "rules": [
    "Players alternate placing a stone on an empty intersection; Black moves first.",
    "Because Black has an advantage, White may instead swap sides on their first turn (the pie rule): the black stone becomes white and Black moves next.",
    "The first player to make an unbroken row of five (or more) stones — horizontally, vertically or diagonally — wins."
  ],
