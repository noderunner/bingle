{
  "id": "draughts",
  "name": "English Draughts (Checkers)",
  "description": "Capture every opposing piece or leave your opponent without a move. Pieces move diagonally, jumps are mandatory, and a piece that reaches the far row is crowned a king.",
  "version": "0.1.0",
  "rules": [
    "Pieces move one square diagonally onto an empty dark square. Ordinary pieces (men) move forward only; kings move forward or backward.",
    "To capture, jump diagonally over an adjacent enemy piece onto the empty square beyond it, removing the jumped piece. Men capture forward only; kings capture in any diagonal direction.",
    "Captures are compulsory: if you can jump, you must. A piece that lands with another jump available must keep jumping in the same move, but a man that reaches the far row is crowned and its move ends there.",
    "A man that reaches the far row becomes a king. You win when your opponent has no legal move (no pieces left, or all blocked). A game that reaches 200 plies is drawn."
  ],
  "guide": { "tabs": [ { "id": "rules", "title": "Rules", "file": "rules.md" } ] },
  "board": {
    "generator": {
      "type": "grid",
      "width": 8,
      "height": 8,
      "adjacency": "diagonal4",
      "labels": "algebraic"
    },
    "style": "squares"
  },
