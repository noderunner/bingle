<!DOCTYPE html>
<html lang="{{.Lang}}" dir="{{.Dir}}">
<head>
	<meta charset="utf-8">
	<meta name="bingle-version" content="{{engineVersion}}">
	<meta name="bingle-brand" content="{{brandName}}"{{if brandHasIcon}} data-icon="{{brandIconURL}}"{{end}}{{with discordURL}} data-discord="{{.}}"{{end}}>
	<meta name="bingle-language" content="{{.Chosen}}" data-browser="{{.Browser}}">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta name="referrer" content="no-referrer">
	<title>{{brandName}} — {{if eq .Action "confirm"}}{{t .Lang "mailpage.title_confirm"}}{{else}}{{t .Lang "mailpage.title_stop"}}{{end}}</title>
	<link rel="icon" type="{{brandIconType}}" href="{{brandIconURL}}">
	<link rel="stylesheet" href="/static/style.css">
</head>
<body>
	<header class="topbar">
		{{template "brand" .}}
	</header>
	<main class="page narrow">
		<section class="card" id="notify-card" data-action="{{.Action}}">
			{{if eq .Action "confirm"}}
			<h1>{{t .Lang "mailpage.confirm_heading"}}</h1>
			<p>{{t .Lang "mailpage.confirm_text" "brand" brandName}}</p>
			<p class="muted small">{{t .Lang "mailpage.confirm_note"}}</p>
			<div class="row"><button type="button" class="primary" id="notify-go">{{t .Lang "account.confirm"}}</button></div>
			{{else}}
			<h1>{{t .Lang "mailpage.stop_heading" "brand" brandName}}</h1>
			<p>{{t .Lang "mailpage.stop_text" "brand" brandName}}</p>
			<div class="row"><button type="button" class="primary" id="notify-go">{{t .Lang "mailpage.stop_all"}}</button></div>
			{{end}}
			<p class="small" id="notify-result" role="status"></p>
		</section>
	</main>
	<footer class="site-footer"><sub title="{{t .Lang "footer.version" "brand" brandFooter}}"><bdi>{{brandFooter}} v{{engineVersion}}</bdi> · <bdi>{{t .Lang "footer.license"}}</bdi> · <a href="https://github.com/noderunner/bingle" target="_blank" rel="noopener noreferrer">GitHub</a>{{with discordURL}} · <a href="{{.}}" target="_blank" rel="noopener noreferrer">Discord</a>{{end}}</sub></footer>
	<!-- First, so a fault in any module below is reported (docs/observability.md). -->
	<script type="module" src="/static/js/errors.js"></script>
{{template "brand-script" .}}	<script type="module" src="/static/js/notify.js"></script>
</body>
</html>
