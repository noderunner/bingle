<!DOCTYPE html>
<html lang="{{.Lang}}" dir="{{.Dir}}">
<head>
	<meta charset="utf-8">
	<meta name="bingle-version" content="{{engineVersion}}">
	<meta name="bingle-brand" content="{{brandName}}"{{if brandHasIcon}} data-icon="{{brandIconURL}}"{{end}}>
	<meta name="bingle-language" content="{{.Chosen}}" data-browser="{{.Browser}}">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta name="referrer" content="no-referrer">
	<title>{{brandName}} — {{t .Lang "account.admin"}}</title>
	<link rel="icon" type="{{brandIconType}}" href="{{brandIconURL}}" id="favicon">
	<link rel="stylesheet" href="/static/style.css">
</head>
<body>
	<header class="topbar">
		{{template "brand" .}}
		<span class="spacer"></span>
	</header>
	<main class="page narrow">
		<h1>{{t .Lang "account.admin"}}</h1>
		<p class="small error" id="admin-refused" hidden></p>
		<p class="small" id="admin-second-factor" hidden><a class="button primary" href="/account#tf-box">{{t .Lang "admin.set_up_second"}}</a></p>
		<section class="card" id="caps-card" hidden>
			<h2>{{t .Lang "admin.caps"}}</h2>
			<p class="small" id="caps-mode"></p>
			<p class="small" id="caps-drift" hidden>{{t .Lang "admin.drift_html"}}</p>
			<div class="admin-scroll">
				<table class="admin-table caps" id="caps-table">
					<thead><tr><th scope="col">{{t .Lang "admin.capability"}}</th><th scope="col" class="col-check">{{t .Lang "admin.users"}}</th><th scope="col" class="col-check">{{t .Lang "admin.guests"}}</th></tr></thead>
					<tbody id="caps-rows"></tbody>
				</table>
			</div>
			<p class="small muted">{{t .Lang "admin.caps_note"}}</p>
			<h3>{{t .Lang "admin.limits"}}</h3>
			<div class="admin-scroll">
				<table class="admin-table limits">
					<thead><tr><th scope="col">{{t .Lang "admin.limit_what"}}</th><th scope="col" class="num">{{t .Lang "admin.users"}}</th><th scope="col" class="num">{{t .Lang "admin.guests"}}</th></tr></thead>
					<tbody id="caps-limits"></tbody>
				</table>
			</div>
			<p class="small" id="caps-result" role="status" aria-live="polite"></p>
		</section>
		<section class="card" id="events-card" hidden>
			<h2>{{t .Lang "admin.events"}}</h2>
			<p class="small muted">{{t .Lang "admin.events_note"}}</p>
			<div class="admin-scroll">
				<table class="admin-table events" id="events-table">
					<thead><tr><th scope="col">{{t .Lang "admin.when"}}</th><th scope="col">{{t .Lang "settings.account"}}</th><th scope="col">{{t .Lang "admin.what"}}</th><th scope="col">{{t .Lang "admin.detail"}}</th></tr></thead>
					<tbody id="events-rows"></tbody>
				</table>
			</div>
		</section>
		<section class="card" id="invite-card" hidden>
			<h2>{{t .Lang "admin.invitations"}}</h2>
			<p class="small" id="invite-state"></p>
			<div class="row"><button type="button" class="primary" id="invite-go">{{t .Lang "admin.make_invite"}}</button></div>
			<p class="small" id="invite-link"></p>
		</section>
	</main>
	<footer class="site-footer"><sub title="{{t .Lang "footer.version" "brand" brandFooter}}"><bdi>{{brandFooter}} v{{engineVersion}}</bdi> · <bdi>{{t .Lang "footer.license"}}</bdi> · <a href="https://github.com/noderunner/bingle" target="_blank" rel="noopener noreferrer">GitHub</a></sub></footer>
	<script type="module" src="/static/js/errors.js"></script>
{{template "brand-script" .}}	<script type="module" src="/static/js/admin.js"></script>
</body>
</html>
