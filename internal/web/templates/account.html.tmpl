<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="bingle-version" content="{{engineVersion}}">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta name="referrer" content="no-referrer">
	<title>Bingle — {{.Title}}</title>
	<link rel="icon" type="image/svg+xml" href="/static/favicon.svg" id="favicon">
	<link rel="stylesheet" href="/static/style.css">
</head>
<body data-page="{{.Page}}">
	<header class="topbar">
		<a class="brand" href="/"><span class="logo"></span>Bingle</a>
		<span class="spacer"></span>
	</header>

	<main class="page narrow">
		{{if eq .Page "login"}}
		<section class="card" id="login-card">
			<h1>Sign in</h1>
			<p class="small error" id="login-error" hidden></p>
			<div class="row" id="oidc-buttons" hidden></div>
			<form id="login-form" novalidate>
				<div class="field">
					<label for="login-handle">Handle</label>
					<input id="login-handle" type="text" maxlength="25" autocomplete="username" autocapitalize="none" spellcheck="false" required>
				</div>
				<div class="field">
					<label for="login-password">Password</label>
					<input id="login-password" type="password" maxlength="256" autocomplete="current-password" required>
				</div>
				<div class="row">
					<button type="submit" class="primary" id="login-go">Sign in</button>
				</div>
				<p class="small" id="account-result" role="status" aria-live="polite"></p>
			</form>
			<form id="second-form" novalidate hidden>
				<div class="field">
					<label for="second-code">Code from your authenticator app</label>
					<input id="second-code" type="text" inputmode="numeric" maxlength="11" autocomplete="one-time-code" autocapitalize="none" spellcheck="false" required>
					<span class="small muted">Or one of your recovery codes, if you do not have the app to hand.</span>
				</div>
				<div class="row">
					<button type="submit" class="primary" id="second-go">Sign in</button>
				</div>
				<p class="small" id="second-result" role="status" aria-live="polite"></p>
			</form>
			<p class="small muted"><a href="/forgot" id="forgot-link">Forgot your password?</a></p>
			<p class="small muted" id="login-signup" hidden>No account? <a href="/signup">Sign up</a>. You can also just play: games need no account.</p>
		</section>
		{{else if eq .Page "signup"}}
		<section class="card" id="signup-card">
			<h1>Sign up</h1>
			<p class="muted small">An account keeps your games with you on any device, and gets you direct messages and the global chat. The games you played as a guest in this browser become your account's.</p>
			<form id="oidc-signup-form" novalidate hidden>
				<p class="small" id="oidc-signup-who"></p>
				<div class="field">
					<label for="oidc-handle">Choose a handle</label>
					<input id="oidc-handle" type="text" maxlength="25" autocomplete="username" autocapitalize="none" spellcheck="false" required>
					<span class="small muted">3 to 24 letters, digits, "_" or "-". Others see it as @handle.</span>
				</div>
				<div class="row"><button type="submit" class="primary" id="oidc-go">Make my account</button></div>
				<p class="small" id="oidc-result" role="status" aria-live="polite"></p>
			</form>
			<div class="row" id="signup-oidc-buttons" hidden></div>
			<form id="signup-form" novalidate>
				<div class="field">
					<label for="signup-handle">Handle</label>
					<input id="signup-handle" type="text" maxlength="25" autocomplete="username" autocapitalize="none" spellcheck="false" required>
					<span class="small muted">3 to 24 letters, digits, "_" or "-". Others see it as @handle.</span>
				</div>
				<div class="field">
					<label for="signup-email">Email</label>
					<input id="signup-email" type="email" maxlength="254" autocomplete="email" required>
					<span class="small muted">Bingle mails a link to confirm it, and never shows it to anybody.</span>
				</div>
				<div class="field">
					<label for="signup-password">Password</label>
					<input id="signup-password" type="password" minlength="10" maxlength="256" autocomplete="new-password" required>
					<span class="small muted">At least 10 characters.</span>
				</div>
				<div class="row">
					<button type="submit" class="primary" id="signup-go">Sign up</button>
				</div>
				<p class="small" id="account-result" role="status" aria-live="polite"></p>
			</form>
			<p class="small muted">Have an account? <a href="/login">Sign in</a>.</p>
		</section>
		{{else if eq .Page "forgot"}}
		<section class="card" id="forgot-card">
			<h1>Forgot your password</h1>
			<form id="forgot-form" novalidate>
				<div class="field">
					<label for="forgot-who">Your handle or email address</label>
					<input id="forgot-who" type="text" maxlength="254" autocomplete="username" autocapitalize="none" spellcheck="false" required>
				</div>
				<div class="row"><button type="submit" class="primary" id="forgot-go">Mail me a link</button></div>
				<p class="small" id="account-result" role="status" aria-live="polite"></p>
			</form>
		</section>
		{{else if eq .Page "reset"}}
		<section class="card" id="reset-card">
			<h1>Choose a new password</h1>
			<form id="reset-form" novalidate>
				<div class="field">
					<label for="reset-password">New password</label>
					<input id="reset-password" type="password" minlength="10" maxlength="256" autocomplete="new-password" required>
					<span class="small muted">At least 10 characters. Every device you are signed in on is signed out.</span>
				</div>
				<div class="field">
					<label for="reset-code">Code from your authenticator app, or a recovery code</label>
					<input id="reset-code" type="text" maxlength="11" autocomplete="one-time-code" autocapitalize="none" spellcheck="false">
					<span class="small muted">Only if your account signs in with a code.</span>
				</div>
				<div class="row"><button type="submit" class="primary" id="reset-go">Set the password</button></div>
				<p class="small" id="account-result" role="status" aria-live="polite"></p>
			</form>
		</section>
		{{else if eq .Page "confirm"}}
		<section class="card" id="confirm-card">
			<h1>Confirm your account</h1>
			<p>Press the button to finish making your Bingle account. Nothing happens until you do.</p>
			<div class="row"><button type="button" class="primary" id="confirm-go">Confirm</button></div>
			<p class="small" id="account-result" role="status" aria-live="polite"></p>
		</section>
		{{else}}
		<section class="card" id="account-card">
			<h1>Your account</h1>
			<p id="account-who"></p>
			<p class="small error" id="account-must-change" hidden>Choose a new password before you go on: the one you signed in with was given to you.</p>
			<form id="password-form" novalidate>
				<h2 id="password-title">Change your password</h2>
				<div class="field" id="password-old-field">
					<label for="password-old">Current password</label>
					<input id="password-old" type="password" maxlength="256" autocomplete="current-password" required>
				</div>
				<div class="field">
					<label for="password-new">New password</label>
					<input id="password-new" type="password" minlength="10" maxlength="256" autocomplete="new-password" required>
					<span class="small muted">At least 10 characters. Every other device you are signed in on is signed out.</span>
				</div>
				<div class="row">
					<button type="submit" class="primary" id="password-go">Change the password</button>
				</div>
				<p class="small" id="account-result" role="status" aria-live="polite"></p>
			</form>
			<section id="oidc-box" hidden>
				<h2>Signing in with another account</h2>
				<p class="small error" id="oidc-error" hidden></p>
				<ul id="oidc-links"></ul>
			</section>
			<section id="tf-box">
				<h2>Two-step sign-in</h2>
				<p class="small error" id="tf-needed" hidden>An administrator signs in with a code from an app as well as the password. Set it up before you go on.</p>
				<p class="small" id="tf-state"></p>
				<div class="field" id="tf-password-field">
					<label for="tf-password">Your password</label>
					<input id="tf-password" type="password" maxlength="256" autocomplete="current-password">
				</div>
				<div class="row" id="tf-off-actions" hidden>
					<button type="button" class="primary" id="tf-setup">Set it up</button>
				</div>
				<div id="tf-setting-up" hidden>
					<p class="small">Add this to your authenticator app (any app that does "TOTP"), by typing the key or opening the link on your phone, then give the code it shows.</p>
					<p class="small">Key: <code id="tf-secret"></code></p>
					<p class="small">Link: <code id="tf-uri" class="wrap"></code></p>
					<div class="field">
						<label for="tf-code">Code</label>
						<input id="tf-code" type="text" inputmode="numeric" maxlength="6" autocomplete="one-time-code">
					</div>
					<div class="row"><button type="button" class="primary" id="tf-enable">Turn it on</button></div>
				</div>
				<div id="tf-codes-box" hidden>
					<p class="small">Your recovery codes. Each works once, instead of a code from the app. Keep them somewhere safe: they are shown only now.</p>
					<ul class="mono" id="tf-codes"></ul>
				</div>
				<div id="tf-on-actions" hidden>
					<div class="field">
						<label for="tf-off-code">A code from the app (or a recovery code), to turn it off</label>
						<input id="tf-off-code" type="text" maxlength="11" autocomplete="one-time-code">
					</div>
					<div class="row">
						<button type="button" class="ghost" id="tf-renew">New recovery codes</button>
						<button type="button" class="ghost" id="tf-off">Turn it off</button>
					</div>
				</div>
				<p class="small" id="tf-result" role="status" aria-live="polite"></p>
			</section>
			<section id="tokens-box">
				<h2>API tokens</h2>
				<p class="small muted">For scripts and agents: send a token as <code>Authorization: Bearer …</code>. It acts as you, within what its scopes allow, and never with an administrator's powers.</p>
				<ul id="tokens-list"></ul>
				<div class="field">
					<label for="token-name">Name</label>
					<input id="token-name" type="text" maxlength="40">
				</div>
				<div class="row" id="token-scopes"></div>
				<div class="row"><button type="button" class="ghost" id="token-go">Make a token</button></div>
				<p class="small" id="token-new"></p>
			</section>
			<p class="small" id="admin-link" hidden><a href="/admin">Administration</a></p>
			<div class="row"><button type="button" class="ghost" id="logout-go">Sign out</button></div>
		</section>
		{{end}}
	</main>

	<footer class="site-footer"><sub title="The version of the bingle engine">bingle v{{engineVersion}} · MIT License · <a href="https://github.com/noderunner/bingle" target="_blank" rel="noopener noreferrer">GitHub</a></sub></footer>

	<!-- First, so a fault in any module below is reported (docs/observability.md). -->
	<script type="module" src="/static/js/errors.js"></script>
	<script type="module" src="/static/js/account.js"></script>
</body>
</html>
