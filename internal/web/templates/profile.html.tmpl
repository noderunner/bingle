<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="bingle-version" content="{{engineVersion}}">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Bingle — All Settings</title>
	<link rel="icon" type="image/svg+xml" href="/static/favicon.svg" id="favicon">
	<link rel="stylesheet" href="/static/style.css">
</head>
<body>
	<header class="topbar">
		<a class="brand" href="/"><span class="logo"></span>Bingle</a>
		<span class="spacer"></span>
		<span class="topbar-actions" id="topbar-actions"></span>
	</header>

	<main class="page narrow">
		<h1>All Settings</h1>

		<section class="card" id="account-box" hidden>
			<h2>Account</h2>
			<p id="account-line"></p>
		</section>

		<section class="card" id="ratings-box" hidden>
			<h2>Ratings</h2>
			<p class="muted small" id="ratings-note"></p>
			<div class="table-scroll"><table class="data"><thead><tr><th>Game</th><th>Rating</th><th>Won</th><th>Drawn</th><th>Lost</th><th></th></tr></thead><tbody id="ratings-rows"></tbody></table></div>
		</section>

		<section class="card" id="upgrade-box" hidden>
			<h2>Make an Account</h2>
			<p class="small">Email notifications, direct messages and the global chat are for signed-in players now. This browser confirmed an email address already, so it can become your account at once: choose a username and a password, and your games, and your turn mail, carry on.</p>
			<form id="upgrade-form" novalidate>
				<div class="field">
					<label for="upgrade-handle">Username</label>
					<input id="upgrade-handle" type="text" maxlength="25" autocapitalize="none" spellcheck="false">
				</div>
				<div class="field">
					<label for="upgrade-password">Password</label>
					<input id="upgrade-password" type="password" minlength="10" maxlength="256" autocomplete="new-password">
				</div>
				<div class="row"><button type="submit" class="primary" id="upgrade-go">Make my account</button></div>
				<p class="small" id="upgrade-result" role="status" aria-live="polite"></p>
			</form>
		</section>

		<section class="card" id="profile-card">
			<h2>My Name</h2>
			<form id="profile-form" novalidate>
				<div class="field">
					<label for="profile_name" class="sr-only">Name</label>
					<input id="profile_name" type="text" maxlength="32" autocomplete="nickname">
					<span class="small muted">Saved in this browser. Games you already joined keep the name you used in them.</span>
				</div>
				<div id="profile-email-section">
				<hr class="section-divider">
				<h2>Email Notifications</h2>
				<p class="small muted" id="notify-accounts-only" hidden>Email notifications are for signed-in players: <a href="/login?return=%2Fprofile">sign in</a> to have Bingle mail you when it is your turn.</p>
				<div class="field" id="profile-email-field">
					<label for="profile_email">Email</label>
					<input id="profile_email" type="email" maxlength="254" autocomplete="email" placeholder="you@example.com">
					<span class="small muted">Only used for the turn notices you ask for. Bingle mails a link to confirm the address first, and never shows it to other players.</span>
				</div>
				<div class="field" id="profile-notify-field">
					<label class="check"><input type="checkbox" id="profile_notify"> <span>Send me an email when it is my turn</span></label>
					<span class="small muted">Applies to games you join or open from now on; you can change it for each game in its options.</span>
				</div>
				<div id="notify-box" class="notify-box" hidden>
					<p class="small" id="notify-status" role="status" aria-live="polite"></p>
					<div class="row" id="notify-actions" hidden>
						<button type="button" class="ghost" id="notify-resend">Send the confirmation again</button>
						<button type="button" class="ghost" id="notify-forget">Forget my address</button>
					</div>
					<div id="notify-notes"></div>
				</div>
				<p class="small muted" id="notify-off" hidden>Email notifications are not set up on this server. What you choose here is kept in this browser for when they are.</p>
				</div>
				<div class="row">
					<button type="submit" class="primary" id="profile-save">Save</button>
					<span class="small" id="profile-status" role="status"></span>
				</div>
			</form>
		</section>

		<section class="card" id="friends-card" hidden>
			<h2>Friends</h2>
			<label class="check"><input type="checkbox" id="friend-mail"> <span>Email me when somebody sends me a friend request</span></label>
			<label class="check"><input type="checkbox" id="friend-presence"> <span>Show when I am online</span></label>
			<p class="small muted">Off, you look offline to your friends and are not in <em>Here now</em>. Friends cannot start a message or call with you, but you can write to them, and they can reply.</p>
			<p class="small" id="friend-settings-status" role="status"></p>
		</section>

		<section class="card" id="finished-card">
			<h2>Finished Games</h2>
			<ul class="my-games" id="finished-games"></ul>
			<p class="muted" id="finished-empty" hidden>No finished games yet.</p>
		</section>
	</main>

	<footer class="site-footer"><sub title="The version of the bingle engine">bingle v{{engineVersion}} · MIT License · <a href="https://github.com/noderunner/bingle" target="_blank" rel="noopener noreferrer">GitHub</a></sub></footer>

	<!-- First, so a fault in any module below is reported (docs/observability.md). -->
	<script type="module" src="/static/js/errors.js"></script>
	<script type="module" src="/static/js/profile.js"></script>
</body>
</html>
