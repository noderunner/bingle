<!DOCTYPE html>
<html lang="{{.Lang}}" dir="{{.Dir}}">
<head>
	<meta charset="utf-8">
	<meta name="bingle-version" content="{{engineVersion}}">
	<meta name="bingle-brand" content="{{brandName}}"{{if brandHasIcon}} data-icon="{{brandIconURL}}"{{end}}{{with discordURL}} data-discord="{{.}}"{{end}}>
	<meta name="bingle-language" content="{{.Chosen}}" data-browser="{{.Browser}}">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>{{brandName}} — {{t .Lang "profile.all_settings"}}</title>
	<link rel="icon" type="{{brandIconType}}" href="{{brandIconURL}}" id="favicon">
	<link rel="stylesheet" href="/static/style.css">
</head>
<body>
	<header class="topbar">
		{{template "brand" .}}
		<span class="spacer"></span>
		<span class="topbar-actions" id="topbar-actions"></span>
	</header>

	<main class="page narrow">
		<h1>{{t .Lang "profile.all_settings"}}</h1>

		<div class="tabs" role="tablist" aria-label="{{t .Lang "settings.tabs"}}">
			<button type="button" role="tab" class="tab" id="tab-settings" data-tab="settings" aria-controls="panel-settings" aria-selected="true">{{t .Lang "settings.settings"}}</button>
			<button type="button" role="tab" class="tab" id="tab-badges" data-tab="badges" aria-controls="panel-badges" aria-selected="false" tabindex="-1" hidden>{{t .Lang "settings.badges"}}</button>
			<button type="button" role="tab" class="tab" id="tab-finished" data-tab="finished" aria-controls="panel-finished" aria-selected="false" tabindex="-1">{{t .Lang "settings.finished"}}</button>
		</div>

		<div role="tabpanel" id="panel-settings" aria-labelledby="tab-settings">

		<section class="card" id="account-box" hidden>
			<h2>{{t .Lang "settings.account"}}</h2>
			<p id="account-line"></p>
		</section>

		<section class="card" id="ratings-box" hidden>
			<h2>{{t .Lang "settings.ratings"}}</h2>
			<p class="muted small" id="ratings-note"></p>
			<div class="table-scroll"><table class="data"><thead><tr><th>{{t .Lang "settings.game"}}</th><th>{{t .Lang "settings.rating"}}</th><th>{{t .Lang "settings.won"}}</th><th>{{t .Lang "settings.drawn"}}</th><th>{{t .Lang "settings.lost"}}</th><th></th></tr></thead><tbody id="ratings-rows"></tbody></table></div>
		</section>

		<section class="card" id="upgrade-box" hidden>
			<h2>{{t .Lang "settings.make_account"}}</h2>
			<p class="small">{{t .Lang "settings.make_account_note"}}</p>
			<form id="upgrade-form" novalidate>
				<div class="field">
					<label for="upgrade-handle">{{t .Lang "settings.username"}}</label>
					<input id="upgrade-handle" type="text" maxlength="25" autocapitalize="none" spellcheck="false">
				</div>
				<div class="field">
					<label for="upgrade-password">{{t .Lang "settings.password"}}</label>
					<input id="upgrade-password" type="password" minlength="10" maxlength="256" autocomplete="new-password">
				</div>
				<div class="row"><button type="submit" class="primary" id="upgrade-go">{{t .Lang "settings.make_my_account"}}</button></div>
				<p class="small" id="upgrade-result" role="status" aria-live="polite"></p>
			</form>
		</section>

		<section class="card" id="profile-card">
			<h2>{{t .Lang "profile.my_name"}}</h2>
			<form id="profile-form" novalidate>
				<div class="field">
					<label for="profile_name" class="sr-only">{{t .Lang "settings.name"}}</label>
					<input id="profile_name" type="text" maxlength="32" autocomplete="nickname">
					<span class="small muted">{{t .Lang "settings.name_note"}}</span>
				</div>
				<div id="profile-email-section">
				<hr class="section-divider">
				<h2>{{t .Lang "settings.email_notifications"}}</h2>
				<p class="small muted" id="notify-accounts-only" hidden>{{t .Lang "settings.accounts_only_html" "brand" brandName}}</p>
				<div class="field" id="profile-email-field">
					<label for="profile_email">{{t .Lang "settings.email"}}</label>
					<input id="profile_email" type="email" maxlength="254" autocomplete="email" placeholder="you@example.com">
					<span class="small muted">{{t .Lang "settings.email_note" "brand" brandName}}</span>
				</div>
				<div class="field" id="profile-notify-field">
					<label class="check"><input type="checkbox" id="profile_notify"> <span>{{t .Lang "settings.notify"}}</span></label>
					<span class="small muted">{{t .Lang "settings.notify_note"}}</span>
				</div>
				<div id="notify-box" class="notify-box" hidden>
					<p class="small" id="notify-status" role="status" aria-live="polite"></p>
					<div class="row" id="notify-actions" hidden>
						<button type="button" class="ghost" id="notify-resend">{{t .Lang "settings.resend"}}</button>
						<button type="button" class="ghost" id="notify-forget">{{t .Lang "settings.forget"}}</button>
					</div>
					<div id="notify-notes"></div>
				</div>
				<p class="small muted" id="notify-off" hidden>{{t .Lang "settings.notify_off"}}</p>
				</div>
				<div class="row">
					<button type="submit" class="primary" id="profile-save">{{t .Lang "common.save"}}</button>
					<span class="small" id="profile-status" role="status"></span>
				</div>
			</form>
		</section>

		<section class="card" id="language-card">
			<h2>{{t .Lang "language.label"}}</h2>
			<div id="profile-language"></div>
		</section>

		<section class="card" id="friends-card" hidden>
			<h2>{{t .Lang "settings.friends"}}</h2>
			<label class="check"><input type="checkbox" id="friend-mail"> <span>{{t .Lang "settings.friend_mail"}}</span></label>
			<label class="check"><input type="checkbox" id="friend-invites"> <span>{{t .Lang "settings.friend_invites"}}</span></label>
			<label class="check"><input type="checkbox" id="friend-presence"> <span>{{t .Lang "settings.friend_presence"}}</span></label>
			<p class="small muted">{{t .Lang "settings.presence_note_html"}}</p>
			<p class="small" id="friend-settings-status" role="status"></p>
		</section>

		</div>

		<div role="tabpanel" id="panel-badges" aria-labelledby="tab-badges" hidden>
		<section class="card" id="badges-box" hidden>
			<h2>{{t .Lang "settings.badges"}}</h2>
			<p class="muted small" id="badges-empty" hidden>{{t .Lang "settings.no_badges"}}</p>
			<div id="badges-list"></div>
			<p class="small">{{t .Lang "settings.player_page_html"}}</p>
		</section>
		</div>

		<div role="tabpanel" id="panel-finished" aria-labelledby="tab-finished" hidden>
		<section class="card" id="finished-card">
			<h2>{{t .Lang "settings.finished"}}</h2>
			<ul class="my-games" id="finished-games"></ul>
			<p class="muted" id="finished-empty" hidden>{{t .Lang "settings.no_finished"}}</p>
		</section>
		</div>
	</main>

	<footer class="site-footer"><sub title="{{t .Lang "footer.version" "brand" brandFooter}}"><bdi>{{brandFooter}} v{{engineVersion}}</bdi> · <bdi>{{t .Lang "footer.license"}}</bdi> · <a href="https://github.com/noderunner/bingle" target="_blank" rel="noopener noreferrer">GitHub</a>{{with discordURL}} · <a href="{{.}}" target="_blank" rel="noopener noreferrer">Discord</a>{{end}}</sub></footer>

	<!-- First, so a fault in any module below is reported (docs/observability.md). -->
	<script type="module" src="/static/js/errors.js"></script>
{{template "brand-script" .}}	<script type="module" src="/static/js/profile.js"></script>
</body>
</html>
