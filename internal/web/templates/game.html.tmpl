<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="bingle-version" content="{{engineVersion}}">
	<meta name="bingle-brand" content="{{brandName}}"{{if brandHasIcon}} data-icon="{{brandIconURL}}"{{end}}>
	<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
	<title>{{brandName}} — Game {{.Code}}</title>
	<link rel="icon" type="{{brandIconType}}" href="{{brandIconURL}}" id="favicon">
	<link rel="stylesheet" href="/static/style.css">
	<link rel="stylesheet" href="/static/themes.css">
</head>
<body data-room-code="{{.Code}}">
	<header class="topbar">
		<a class="brand" href="/"><span class="logo{{if brandHasIcon}} custom{{end}}"></span>{{brandName}}</a>
		<span class="spacer"></span>
		<span class="topbar-actions" id="topbar-actions"></span>
	</header>

	<main class="page page-game">
		<!-- The game options window and the tooltips live outside #game-root, which is rebuilt on every move. -->
		<div id="game-root"><p class="muted">Loading game {{.Code}}…</p></div>
	</main>

	<footer class="site-footer"><sub title="The version of the {{brandFooter}} engine">{{brandFooter}} v{{engineVersion}} · MIT License · <a href="https://github.com/noderunner/bingle" target="_blank" rel="noopener noreferrer">GitHub</a></sub></footer>

	<!-- First, so a fault in any module below is reported (docs/observability.md). -->
	<script type="module" src="/static/js/errors.js"></script>
	<script type="module" src="/static/js/game.js"></script>
</body>
</html>
