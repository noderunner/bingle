<!DOCTYPE html>
<html lang="{{.Lang}}" dir="{{.Dir}}">
<head>
	<meta charset="utf-8">
	<meta name="bingle-version" content="{{engineVersion}}">
	<meta name="bingle-brand" content="{{brandName}}"{{if brandHasIcon}} data-icon="{{brandIconURL}}"{{end}}>
	<meta name="bingle-language" content="{{.Chosen}}" data-browser="{{.Browser}}">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>{{brandName}} — {{t .Lang "player.title"}}</title>
	<link rel="icon" type="{{brandIconType}}" href="{{brandIconURL}}" id="favicon">
	<link rel="stylesheet" href="/static/style.css">
</head>
<body>
	<header class="topbar">
		<a class="brand" href="/"><span class="logo{{if brandHasIcon}} custom{{end}}"></span>{{brandName}}</a>
		<span class="spacer"></span>
		<span class="topbar-actions" id="topbar-actions"></span>
	</header>

	<main class="page narrow">
		<h1 id="player-title">{{t .Lang "player.title"}}</h1>
		<p class="muted" id="player-note" hidden></p>

		<section class="card" id="player-badges-box" hidden>
			<h2>{{t .Lang "settings.badges"}}</h2>
			<div id="player-badges"></div>
		</section>

		<section class="card" id="player-ratings-box" hidden>
			<h2>{{t .Lang "settings.ratings"}}</h2>
			<div class="table-scroll"><table class="data"><thead><tr><th>{{t .Lang "settings.game"}}</th><th>{{t .Lang "settings.rating"}}</th><th>{{t .Lang "settings.won"}}</th><th>{{t .Lang "settings.drawn"}}</th><th>{{t .Lang "settings.lost"}}</th></tr></thead><tbody id="player-ratings"></tbody></table></div>
		</section>
	</main>

	<footer class="site-footer"><sub title="{{t .Lang "footer.version" "brand" brandFooter}}"><bdi>{{brandFooter}} v{{engineVersion}}</bdi> · <bdi>{{t .Lang "footer.license"}}</bdi> · <a href="https://github.com/noderunner/bingle" target="_blank" rel="noopener noreferrer">GitHub</a></sub></footer>

	<!-- First, so a fault in any module below is reported (docs/observability.md). -->
	<script type="module" src="/static/js/errors.js"></script>
	<script type="module" src="/static/js/player.js"></script>
</body>
</html>
